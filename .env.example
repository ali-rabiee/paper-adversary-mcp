# Copy to .env (gitignored). The server loads this file at startup.

# Long-lived token for your Claude plan, created with `claude setup-token`.
# Agents run as headless Claude Code processes on your plan; no API key is used.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: where runs are written (default: <repo>/runs).
# PAPER_ADVERSARY_RUNS_DIR=

# Optional: Semantic Scholar API key (raises its rate limit).
# S2_API_KEY=

# Optional: contact e-mail for the OpenAlex / Crossref "polite pool".
# PAPER_ADVERSARY_CONTACT_EMAIL=
